polkit.addRule(function(action, subject) { if (subject.user == "raspi" && ( action.id == 
            "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.reboot-multiple-sessions" 
            ||
            action.id == "org.freedesktop.login1.power-off" || action.id == 
            "org.freedesktop.login1.power-off-multiple-sessions"
        )) { return polkit.Result.YES;
    }
});
